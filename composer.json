{
    "name": "cipriani94/laravel-gateway-mailer",
    "description": "Laravel mail transport that forwards outgoing email to a remote HTTP gateway API using Bearer token authentication",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "symfony/mailer": "^6.2|^7.0|^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.1|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cipriani\\GatewayMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cipriani\\GatewayMailer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cipriani\\GatewayMailer\\GatewayMailerServiceProvider"
            ]
        }
    }
}
